#!name=G1 Pro Annual Test
#!desc=v7.6.0 Pintu masuk kompatibilitas: Mereferensikan skrip tiga tingkat G1 ACQ yang sama, mendukung uji coba gratis 1 bulan Ultra, 20TB g1.20tb.1month_eft.acq, 30TB g1.ai.ultra.1month_eft.acq, dengan cadangan 90p tiga bulan independen per tingkat; target uji promo 12 bulan 2TB g1.2tb.ai.12months_ip_90p (tanpa .acq); pengumpulan pasif dalam cakupan /ai? lama, mendukung diagnostik 10 respons terakhir / penambahan baru / duplikat; modul utama saat ini adalah g1-acq-v7.sgmodule, cukup aktifkan satu saja; tidak melakukan kueri aktif seluruh katalog SKU
#!system=ios
# Penulis Asli (Original Author): crhywun (https://github.com/crhywun/g1-acq)
# Penerjemah Bahasa Indonesia (Translator): Somaylab (https://github.com/somaylab/g1-acq)

[Rule]
# Sama seperti modul lama: blokir UDP 443, berlaku untuk lalu lintas yang menggunakan konfigurasi ini.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.6.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
