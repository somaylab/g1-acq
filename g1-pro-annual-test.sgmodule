#!name=Uji Kelayakan Tahunan G1 Pro
#!desc=Entri kompatibilitas pengelolaan SKU v7.12.0: mengacu pada g1-acq-v7.12-mappings dengan cakupan respons khusus /ai?, mendukung lima templat siap pakai, namespace com.google.gemini.*, dan editor manual lokal maks. 30 aturan; aktifkan hanya satu entri penulisan ulang
#!system=ios

[Rule]
# Sama dengan modul lama: blokir UDP 443 untuk lalu lintas yang memakai konfigurasi ini.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
