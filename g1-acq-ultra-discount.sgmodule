#!name=Manajemen SKU G1 ACQ
#!desc=v7.12.0 Lima templat siap pakai: Pro 99p (g1.ios.2tb. -> com.google.gemini.2tb.ai.m.3month_ip_99p), Turki 20TB (g1.ios.20tb.m, 1989.99 TRY), Turki 30TB (g1.ios.30tb.m, 2949.99 TRY), Ultra 3 bln 75p, dan Pro 12 bln 90p; Pro & Turki 20TB dapat dipakai bersamaan; mendukung namespace g1.*, com.google.one.*, com.google.gemini.*, edit manual maks. 30 aturan, pengumpulan SKU asli, 10 respons terakhir, dan ekspor JSON; aktifkan hanya satu entri penulisan ulang, sambung ulang VPN, buka /g1-sku-report untuk menerapkan templat lalu buka ulang halaman paket
#!system=ios

[Rule]
# Blokir UDP 443 agar permintaan HTTP/3 yang mendukung fallback beralih ke TCP.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.0/g1-acq-discount.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.0/g1-sku-report-discount.js

[MITM]
hostname = %APPEND% one.google.com
