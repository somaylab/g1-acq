#!name=G1 ACQ
#!desc=v7.6.0: Mendukung uji coba gratis 1 bulan Ultra, 20TB g1.20tb.1month_eft.acq, 30TB g1.ai.ultra.1month_eft.acq, dengan cadangan 90p tiga bulan independen per tingkat; uji promo 12 bulan 2TB g1.2tb.ai.12months_ip_90p (tanpa .acq); pengumpulan pasif SKU asli, diagnostik 10 respons terakhir / penambahan baru / duplikat; laporan lokal & ekspor JSON; tidak melakukan kueri aktif seluruh katalog SKU
#!system=ios
# Penulis Asli (Original Author): crhywun (https://github.com/crhywun/g1-acq)
# Penerjemah Bahasa Indonesia (Translator): Somaylab (https://github.com/somaylab/g1-acq)

[Rule]
# Blokir UDP 443 untuk memaksa permintaan HTTP/3 yang mendukung fallback agar beralih ke TCP.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.6.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
