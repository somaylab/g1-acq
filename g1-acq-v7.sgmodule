#!name=Manajemen SKU G1 ACQ (Kompatibilitas Entri Lama)
#!desc=Entri kompatibilitas pengelolaan SKU v7.12.4: menjalankan g1-acq-v7.12-mappings dengan lima templat siap pakai (Pro 99p, Turki 20TB/30TB, Ultra 75p, Pro 12 bln 90p), dukungan namespace com.google.gemini.*, dan editor manual lokal maks. 30 aturan; aktifkan hanya satu entri bersama Manajemen SKU G1 ACQ, sambung ulang VPN lalu buka halaman paket
#!system=ios

[Rule]
# Blokir UDP 443 agar permintaan HTTP/3 yang mendukung fallback beralih ke TCP.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.4/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.4/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
