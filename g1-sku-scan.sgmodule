#!name=Pemindaian SKU Asli G1
#!desc=Pin unduhan v7.12.3 dan laporan lokal; pemindai terpisah tetap memakai pro-annual-test-v2 yang hanya mengumpulkan kandidat g1.* dan com.google.one.* asli sambil meneruskan respons tanpa perubahan; nonaktifkan modul ini saat memakai Manajemen SKU G1 ACQ
#!system=ios

[Rule]
# Sama dengan modul lama: blokir UDP 443 untuk lalu lintas yang memakai konfigurasi ini.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-sku-scan = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.3/g1-sku-scan.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.12.3/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
