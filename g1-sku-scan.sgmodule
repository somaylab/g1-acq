#!name=G1 SKU Scan
#!desc=Mengumpulkan kandidat SKU dalam respons one.google.com dan mempertahankan isi respons asli; lihat dan ekspor di halaman laporan lokal
#!system=ios
# Penulis Asli (Original Author): crhywun (https://github.com/crhywun/g1-acq)
# Penerjemah Bahasa Indonesia (Translator): Somaylab (https://github.com/somaylab/g1-acq)

[Rule]
# Sama seperti modul lama: blokir UDP 443, berlaku untuk lalu lintas yang menggunakan konfigurasi ini.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-sku-scan = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.6.0/g1-sku-scan.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/somaylab/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
